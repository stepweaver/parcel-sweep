# Optional — improves depot geocoding accuracy. Without it, OpenStreetMap Nominatim is used.
# Also enables Google Places autocomplete on Quick Route when "Places API" is enabled on the same key.
# Obtain from https://console.cloud.google.com/ (enable "Geocoding API" + "Places API").
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here

# Optional — OpenAI for Field Capture (server-side transcription + address parsing).
# gpt-4o-transcribe for audio; gpt-4o-mini structured output for splitting addresses.
# The app starts without this key: paste/type and heuristic splitting still work.
OPENAI_API_KEY=

# Optional — Google Maps Platform Address Validation API (server-only; never put this in frontend code).
# Used as the location authority for Field Capture (AI parses; Google validates).
# The app starts without this key: local providers and manual map-pin verification still work.
#
# Enable "Address Validation API" on the Google Cloud project:
#   https://console.cloud.google.com/apis/library/addressvalidation.googleapis.com
# Billing is required. Restrict the key to Address Validation API.
# This is a different API from Geocoding/Places; a Geocoding key only works after
# Address Validation is enabled on the same project. You may reuse that key in this var.
GOOGLE_ADDRESS_VALIDATION_API_KEY=

# Optional USPS CASS processing for Address Validation. Default: false (off).
# Set to true only if your Google Cloud billing/account supports CASS.
GOOGLE_ADDRESS_VALIDATION_ENABLE_CASS=false

# Optional — defaults to the public OSRM demo instance.
# For production use, run your own OSRM server:
#   https://github.com/Project-OSRM/osrm-backend
# The public demo instance has rate limits and no SLA.
OSRM_BASE_URL=http://router.project-osrm.org

# Port the Express server listens on (default: 3000; platforms set this automatically)
PORT=3000

# CORS + Socket.io allowed origin.
# Local dev: http://localhost:5173
# Production (single-service deploy): your public URL, e.g. https://parcel-sweep.up.railway.app
# Railway/Render auto-detect if unset (via RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_URL).
FRONTEND_ORIGIN=http://localhost:5173

# SQLite database file path (optional — defaults to parcel-sweep.db at repo root).
# Production: mount a volume at /data and set DB_PATH=/data/parcel-sweep.db
# DB_PATH=/data/parcel-sweep.db
